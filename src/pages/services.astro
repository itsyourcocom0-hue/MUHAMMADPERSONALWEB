---
import Base from '../layouts/Base.astro';
import Orbit from '../components/Orbit.astro';
import Card from '../components/Card.astro';
import CTA from '../components/CTA.astro';

const services = [
  { id: 'audit', title: 'Funnel diagnosis', intro: 'For a store that isn’t sure where sales are being lost.',
    items: ['Ad account review — campaigns, audiences and creatives', 'Product-page, cart and mobile checkout review', 'Prioritised findings with screenshots and reasoning'],
    outcome: 'A clear answer to which layer is broken, and a fix list organised by impact and effort.' },
  { id: 'store', title: 'Expert fix — Shopify build & CRO', intro: 'For a store whose website is the weak link.',
    items: ['Custom sections, product pages and cart logic in Liquid', 'Built on a duplicate theme, reviewed through preview links', 'Mobile journey, launch checks and documentation'],
    outcome: 'A working storefront and a clear handover.' },
  { id: 'operations', title: 'Operations setup', intro: 'For a business that needs visibility after checkout.',
    items: ['Order-status and fulfilment workflow', 'Courier/COD reconciliation structure', 'Return reasons and unit-economics reporting'],
    outcome: 'A repeatable operating process with ownership made clear.' },
  { id: 'retainer', title: 'Growth partner', intro: 'For a brand ready to grow, with one expert accountable for the whole funnel.',
    items: ['Meta and Google Ads, store and creative working together', 'Continuous CRO testing on fixed test windows', 'Recurring operations and numbers review'],
    outcome: 'A defined scope, review rhythm and accountable point of contact.' },
];
const faq = [
  ['Can we start with a small project?', 'Yes. A focused audit or a defined storefront change can be the starting point. The right scope depends on the problem.'],
  ['Do you guarantee revenue or ROAS?', 'No. Commercial results depend on the offer, market, traffic quality, costs and execution. The work should have clear deliverables and an agreed way to evaluate results.'],
  ['What should I send in an inquiry?', 'Your store URL, the problem you want to solve, your current platform and any timing constraints. Never send passwords or customer data in the first message.'],
  ['How are pricing and availability handled?', 'Both are shared once the scope is understood, so you know what you are getting before work begins.'],
  ['Who actually does the work?', 'I do. Diagnosis, strategy, design and the hands-on build are mine. A small team at Farooqui Inc supports routine execution under my direction, and I stay accountable for the result.'],
];
---
<Base
  title="E-Commerce Services — Shopify, CRO, COD Operations | Muhammad Farooqui"
  description="Funnel diagnosis, custom Shopify builds and CRO, COD/courier operations setup and an ongoing growth partnership — scoped around the layer that is actually broken."
>
  <header class="pagehead">
    <Orbit hot={3} />
    <p class="eyebrow">Services / Ways to work together</p>
    <h1>Fix the constraint.<br /><em>Connect the business.</em></h1>
    <p class="lead">Start with the part that needs attention. Keep the surrounding systems in view.</p>
  </header>

  <div class="services">
  {services.map((s, i) => (
    <section class="service" id={s.id}>
      <span class="number">{String(i + 1).padStart(2, '0')}</span>
      <div>
        <h2>{s.title}</h2>
        <p>{s.intro}</p>
        <a class="textlink" href="/contact">Discuss this scope ↗</a>
      </div>
      <div>
        <ul>{s.items.map((it) => <li>{it}</li>)}</ul>
        <p><strong>What you leave with</strong><br />{s.outcome}</p>
      </div>
    </section>
  ))}
  </div>

  <section class="section">
    <h2>A simple working process.</h2>
    <div class="grid">
      <Card href="/contact" eyebrow="01 / Understand" title="Start with the context." text="Share your store, the current constraint and what a useful outcome looks like." />
      <Card href="/contact" eyebrow="02 / Define" title="Agree on the scope." text="Set deliverables, dependencies and a realistic review process before work begins." />
      <Card href="/contact" eyebrow="03 / Execute" title="Build and review." text="Work through the priorities and leave clear documentation for what happens next." />
    </div>
  </section>

  <section class="section faq">
    <h2>Before we begin.</h2>
    {faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
  </section>
  <CTA />
</Base>
