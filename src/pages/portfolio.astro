---
// Mobile-experience portfolio page — dark/light wave layout, phone mockups,
// glass skill tiles, 3D project carousel. Own styles scoped under .pf.
// Images & testimonials: edit the PF config in the script at the bottom.
import Base from '../layouts/Base.astro';
import { site } from '../config/site';

const skills = [
  { t: 'Meta Ads', s: 'Audits · CBO · creative testing', d: '<path d="M3 11v2a1 1 0 0 0 1 1h2l5 4V6L6 10H4a1 1 0 0 0-1 1z"/><path d="M15 9a4 4 0 0 1 0 6M18 6a8 8 0 0 1 0 12"/>' },
  { t: 'Google Ads', s: 'Search · Shopping · feeds', d: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/><path d="M8 10.5h5"/>' },
  { t: 'CRO & UX', s: 'Product pages · trust · speed', d: '<path d="M3 4h18l-7 8v6l-4 2v-8z"/>' },
  { t: 'Virtual Try-On', s: 'Three.js · MediaPipe', d: '<circle cx="7" cy="13" r="3.5"/><circle cx="17" cy="13" r="3.5"/><path d="M10.5 13h3M3.5 12 2 9M20.5 12 22 9"/>' },
  { t: 'COD & Ops', s: 'Confirmation · couriers', d: '<path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>' },
  { t: 'Product SEO', s: 'JSON-LD · metafields', d: '<path d="M4 4h16v16H4z"/><path d="M8 9h8M8 13h8M8 17h5"/>' },
];

const projects = [
  { tag: 'Built in-house', t: 'Virtual Try-On', x: 'Camera try-on inside the product page — no app download.', pills: ['Three.js', 'MediaPipe', 'Shopify'], href: '/work/virtual-try-on', ui: 'tryon' },
  { tag: 'Product page', t: 'Custom PDP', x: 'Gallery, trust slab, glider tabs and delivery modal — hand-coded.', pills: ['Liquid', 'Metafields', 'JSON-LD'], href: '/work/eyewear-store', img: '/images/pdp.webp', alt: 'Custom product page, store and product names hidden' },
  { tag: 'Add-to-cart', t: 'Sticky Cart Pill', x: 'Follows the thumb, forces a variant, adds over AJAX.', pills: ['AJAX cart', 'Variant logic'], href: '/work/eyewear-store', ui: 'cart' },
  { tag: 'Design system', t: 'One Shared Card', x: 'One snippet powers every grid, ribbon and slider in the store.', pills: ['Snippets', 'Performance'], href: '/work/eyewear-store', img: '/images/cards.webp', alt: 'Shared product card grid, product names hidden' },
  { tag: 'Support', t: 'AI Support Chat', x: 'Answers customers from the store’s own products and policies.', pills: ['AI', 'Admin panel'], href: '/work/gadget-store', ui: 'chat' },
  { tag: 'Ads', t: 'Ad Account Rebuild', x: '3,295 website purchases at Rs 748 each, across 11 campaigns.', pills: ['Meta Ads', 'Audit'], href: '/#work', img: '/images/ads.webp', alt: 'Ads Manager results, campaign names hidden' },
];

const journey = [
  { n: '01', t: 'Diagnose', x: 'Ads, product page, cart and COD flow — I find the layer that leaks.', d: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>' },
  { n: '02', t: 'Strategy & sign-off', x: 'A written plan with priorities. Nothing is built until you approve it.', d: '<path d="M9 11l3 3 8-8"/><path d="M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h9"/>' },
  { n: '03', t: 'Build on a copy', x: 'Hand-coded on a duplicate theme, reviewed by you on your own phone.', d: '<path d="m8 8-5 4 5 4M16 8l5 4-5 4M14 5l-4 14"/>' },
  { n: '04', t: 'Launch & scale', x: 'Go live, measure on fixed test windows, then scale what is proven.', d: '<path d="M5 19 19 5M9 5h10v10"/>' },
];

const proof = [
  { k: 'Meta Ads · one account', q: '3,295 website purchases at an average Rs 748 per purchase, across 11 campaigns.' },
  { k: 'Virtual try-on', q: 'An 86.9 MB 3D frame, shipped as a 2.36 MB model that runs live in a phone browser.' },
  { k: 'Creative pruning', q: 'Winners at 5.50% CTR kept, losers at 2.72% cut — and budget moved to what was already working.' },
];

const wa = site.whatsappUrl || '/contact';
---
<Base
  title="Mobile Commerce Portfolio — Shopify, Try-On & Ads | Muhammad Farooqui"
  description="Mobile-first e-commerce work by Muhammad Farooqui: custom Shopify product pages, a browser virtual try-on, sticky add-to-cart and ad systems built for shoppers on their phones."
  full
>
<Fragment slot="head">
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
<style is:inline>
.pf{--paper:#eef6f4;--paper2:#e2efec;--pink:#082a2c;--pmute:#4d6b6e;--pteal:#0d9488;--pgrad:linear-gradient(120deg,#0d9488,#14b8a6 60%,#2dd4bf);
  --serif:"Instrument Serif",Georgia,serif;position:relative}
.pf :where(h1,h2,h3,h4,p,ul,ol,li){margin:0;padding:0}
.pf ul{list-style:none}
.pf .it{font-family:var(--serif);font-style:italic;font-weight:400;letter-spacing:0;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;padding-right:.06em}
.pf .light .it{background:var(--pgrad);-webkit-background-clip:text;background-clip:text}
.pf .serif{font-family:var(--serif);font-weight:400;letter-spacing:-.01em}
.pf .eb{display:inline-flex;align-items:center;gap:8px;font-size:12px;letter-spacing:.16em;text-transform:uppercase;font-weight:600;color:var(--mint);margin-bottom:16px}
.pf .light .eb{color:var(--pteal)}

/* ---------- flowing ribbons ---------- */
.ribbons{position:absolute;inset:0;overflow:hidden;pointer-events:none;z-index:0}
.ribbons svg{position:absolute;width:140%;left:-20%;height:100%;top:0}
.ribbons .g{transform:translateY(calc(var(--sy,0)*-90px)) rotate(calc(var(--sy,0)*-4deg));transform-origin:50% 50%;transform-box:view-box}
.ribbons path{fill:none;stroke-linecap:round}
.ribbons .r1{animation:drift 14s ease-in-out infinite alternate}
.ribbons .r2{animation:drift 18s ease-in-out infinite alternate-reverse}
.ribbons .r3{animation:drift 22s ease-in-out infinite alternate}
@keyframes drift{to{transform:translate(-60px,26px)}}

/* ---------- hero ---------- */
.pf-hero{position:relative;min-height:100vh;display:grid;align-items:center;padding:120px 0 clamp(120px,14vw,200px)}
.pf-hero .wrap{position:relative;z-index:2;display:grid;grid-template-columns:1fr 1.05fr;gap:clamp(20px,4vw,60px);align-items:center}
.pf-hero h1{font-size:clamp(40px,5.6vw,76px);line-height:1.04;letter-spacing:-.03em;margin-bottom:22px}
.pf-hero h1 .it{font-size:1.08em}
.pf-hero p.lead{max-width:520px;margin-bottom:30px}
.side-dots{position:absolute;left:clamp(10px,2vw,28px);top:50%;transform:translateY(-50%);display:grid;gap:12px;z-index:3}
.side-dots a{width:4px;height:4px;border-radius:50%;background:var(--dim);transition:all .3s}
.side-dots a.on{height:22px;border-radius:4px;background:var(--cyan)}
@media (max-width:760px){.side-dots{display:none}}

/* phones */
.phones{position:relative;height:clamp(440px,48vw,620px);perspective:1600px;--mx:0;--my:0}
.phone{position:absolute;width:clamp(200px,19vw,268px);aspect-ratio:9/19;border-radius:40px;padding:10px;
  background:linear-gradient(150deg,#2a3a3d,#0c1416 40%,#1d2b2e);box-shadow:0 60px 90px -40px rgba(0,0,0,.9),0 0 0 1px rgba(255,255,255,.06) inset,0 0 80px -30px rgba(118,251,238,.35);
  transform-style:preserve-3d;transition:transform .2s linear}
.phone .scr{position:relative;height:100%;border-radius:31px;overflow:hidden;background:#071416;color:var(--ink);font-size:11px;padding:14px 14px 0}
.phone .notch{position:absolute;top:8px;left:50%;transform:translateX(-50%);width:34%;height:20px;border-radius:12px;background:#000;z-index:3}
.ph-a{left:-2%;top:10%;transform:rotateY(calc(18deg + var(--mx)*1deg)) rotateX(calc(8deg + var(--my)*1deg)) rotateZ(-8deg) translateY(calc(var(--sy,0)*-60px))}
.ph-b{right:-2%;top:0;transform:rotateY(calc(-14deg + var(--mx)*1deg)) rotateX(calc(6deg + var(--my)*1deg)) rotateZ(7deg) translateY(calc(var(--sy,0)*40px)) translateZ(40px)}
.sb{display:flex;justify-content:space-between;font-size:10px;font-weight:600;padding:0 6px 10px;color:#cfe}
.sb span:last-child{letter-spacing:2px}
.ph-h{display:flex;justify-content:space-between;align-items:center;margin:6px 0 14px}
.ph-h b{display:block;font-family:var(--disp);font-size:16px}
.ph-h small{color:var(--mute);font-size:10px}
.ph-h i{width:26px;height:26px;border-radius:50%;background:var(--grad);display:grid;place-items:center;color:var(--on-accent);font-style:normal;font-weight:800;font-size:10px}
.ph-chart{border-radius:16px;padding:12px;background:linear-gradient(160deg,rgba(118,251,238,.12),rgba(20,184,166,.04));border:1px solid var(--line);margin-bottom:10px}
.ph-chart small{color:var(--mute);font-size:9.5px;text-transform:uppercase;letter-spacing:.1em}
.ph-chart b{display:block;font-family:var(--disp);font-size:24px;margin:2px 0 4px}
.ph-chart svg{width:100%;height:56px;display:block}
.ph-row{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:10px}
.ph-tile{border-radius:14px;padding:10px;background:rgba(255,255,255,.04);border:1px solid var(--line)}
.ph-tile small{display:block;color:var(--mute);font-size:9px}
.ph-tile b{font-family:var(--disp);font-size:15px}
.ph-white{border-radius:14px;padding:11px 12px;background:#f3fbfa;color:#0b2b2d;display:flex;justify-content:space-between;align-items:center;box-shadow:0 16px 30px -14px rgba(0,0,0,.8)}
.ph-white small{display:block;font-size:9px;color:#5b7b7e}
.ph-white b{font-family:var(--disp);font-size:16px}
.ph-white em{font-style:normal;font-size:10px;font-weight:700;color:#0d9488;background:rgba(13,148,136,.12);padding:4px 8px;border-radius:999px}
.ph-nav{position:absolute;left:12px;right:12px;bottom:10px;display:flex;justify-content:space-around;padding:10px;border-radius:18px;background:rgba(255,255,255,.05);border:1px solid var(--line)}
.ph-nav i{width:16px;height:4px;border-radius:3px;background:var(--dim)}
.ph-nav i:first-child{background:var(--cyan)}
/* product phone */
.pd-img{position:relative;border-radius:18px;height:40%;background:radial-gradient(70% 60% at 50% 55%,#fff,#e9f3f1);display:grid;place-items:center;margin-bottom:10px;overflow:hidden}
.pd-img svg{width:70%}
.pd-try{position:absolute;top:9px;right:9px;display:flex;align-items:center;gap:5px;padding:5px 7px 5px 9px;border-radius:999px;background:#0b2b2d;color:#e8fbff;font-size:8.5px;font-weight:700;letter-spacing:.06em}
.pd-try em{font-style:normal;background:var(--grad);color:var(--on-accent);padding:2px 5px;border-radius:999px;font-size:7px}
.pd-dots{position:absolute;bottom:8px;left:50%;transform:translateX(-50%);display:flex;gap:4px}
.pd-dots i{width:5px;height:5px;border-radius:50%;background:#b9cfcc}.pd-dots i:first-child{width:14px;border-radius:3px;background:#0d9488}
.pd-t{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:6px}
.pd-t b{font-family:var(--disp);font-size:15px}
.pd-t span{color:#ffd77a;font-size:10px;letter-spacing:1px}
.pd-sw{display:flex;gap:6px;margin:8px 0 10px}
.pd-sw i{width:30px;height:30px;border-radius:9px;background:rgba(255,255,255,.06);border:1px solid var(--line);display:grid;place-items:center}
.pd-sw i::after{content:"";width:16px;height:6px;border-radius:3px;background:var(--c)}
.pd-sw i:first-child{border-color:var(--cyan)}
.pd-btn{height:34px;border-radius:12px;display:grid;place-items:center;font-weight:700;font-size:10.5px;letter-spacing:.1em;margin-bottom:7px}
.pd-btn.a{background:var(--grad);color:var(--on-accent)}
.pd-btn.b{border:1px solid var(--line2);color:var(--ink)}
.pd-trust{display:flex;justify-content:space-between;font-size:8.5px;color:var(--mute);padding:4px 2px}
.badge{position:absolute;right:-2%;bottom:6%;z-index:4;display:flex;align-items:center;gap:10px;padding:12px 16px;border-radius:16px;font-size:12.5px;
  background:rgba(9,30,34,.82);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid var(--line2);box-shadow:0 30px 50px -20px rgba(0,0,0,.8);
  transform:translateZ(120px) translateY(calc(var(--sy,0)*-30px));animation:bob 5s ease-in-out infinite}
.badge::before{content:"";width:9px;height:9px;border-radius:50%;background:#4ade80;box-shadow:0 0 12px #4ade80}
.badge b{display:block;font-family:var(--disp)}
.badge small{color:var(--mute)}
@keyframes bob{50%{translate:0 -8px}}
@media (max-width:900px){
  .pf-hero{padding-top:110px}
  .pf-hero .wrap{grid-template-columns:1fr}
  .phones{order:-1;height:clamp(400px,110vw,520px)}
  .phone{width:min(46vw,220px)}
  .ph-a{left:2%}.ph-b{right:2%}
  .badge{right:50%;transform:translateX(50%);bottom:-7%;animation:none;white-space:nowrap}
  .ph-a{left:4%;top:12%}.ph-b{right:4%}
}

/* ---------- waves + light sections ---------- */
.light{position:relative;z-index:3;background:
  radial-gradient(700px 400px at 12% 30%,rgba(13,148,136,.08),transparent 70%),
  radial-gradient(600px 400px at 90% 80%,rgba(13,148,136,.06),transparent 70%),var(--paper);color:var(--pink)}
.light p{color:var(--pmute)}
.wv{position:absolute;left:0;width:100%;height:clamp(60px,9vw,150px);display:block;fill:var(--paper);pointer-events:none}
.wv-t{bottom:calc(100% - 1px)}
.wv-b{top:calc(100% - 1px)}
.light .wrap{position:relative;z-index:2}

/* ---------- about ---------- */
.pf-about{padding:clamp(40px,6vw,80px) 0 clamp(50px,7vw,90px)}
.pf-about .wrap{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(28px,6vw,90px);align-items:center}
.ink{position:relative;aspect-ratio:1;max-width:440px;width:100%;margin-top:clamp(-150px,-10vw,-60px);perspective:1000px}
.ink-c{position:absolute;inset:0;border-radius:50%;overflow:hidden;transform:rotateY(calc(var(--ry,0)*1deg)) rotateX(calc(var(--rx,0)*1deg));transition:transform .2s;
  background:
    radial-gradient(40% 35% at 30% 70%,rgba(13,148,136,.85),transparent 70%),
    radial-gradient(30% 30% at 75% 30%,rgba(45,212,191,.7),transparent 70%),
    radial-gradient(45% 40% at 60% 80%,rgba(8,42,44,.9),transparent 70%),
    radial-gradient(60% 60% at 45% 40%,#cfe3e0,#eef6f4 70%);
  box-shadow:0 50px 80px -40px rgba(8,42,44,.55),0 0 0 10px rgba(255,255,255,.6),0 0 0 11px rgba(13,148,136,.18)}
.ink-c::before,.ink-c::after{content:"";position:absolute;border-radius:50%;filter:blur(2px);animation:ink 9s ease-in-out infinite alternate}
.ink-c::before{width:46%;height:40%;left:-6%;bottom:10%;background:radial-gradient(circle,rgba(8,42,44,.85),transparent 70%)}
.ink-c::after{width:30%;height:30%;right:6%;top:14%;background:radial-gradient(circle,rgba(118,251,238,.9),transparent 70%);animation-duration:7s}
@keyframes ink{to{transform:translate(12px,-14px) scale(1.12)}}
.ink-mono{position:absolute;inset:0;display:grid;place-items:center;font-family:var(--serif);font-style:italic;font-size:clamp(90px,13vw,170px);color:#fff;text-shadow:0 20px 40px rgba(8,42,44,.5);letter-spacing:-.04em}
.ink-c img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:grayscale(1) contrast(1.05);mix-blend-mode:multiply}
.ink-c.has-img .ink-mono{display:none}
.ink .drop{position:absolute;border-radius:50%;background:var(--pgrad);opacity:.85}
.ink .d1{width:18px;height:18px;left:4%;bottom:18%}.ink .d2{width:10px;height:10px;left:-2%;bottom:30%}.ink .d3{width:26px;height:26px;right:2%;top:6%;opacity:.6}
.pf-about h2{font-size:clamp(34px,4.6vw,60px);line-height:1.05;margin-bottom:20px;color:var(--pink)}
.pf-about h2 .serif{display:block}
.pf-about p{max-width:520px;margin-bottom:28px;font-size:16.5px}
.stats{display:grid;grid-template-columns:repeat(3,auto);gap:clamp(18px,4vw,50px);justify-content:start}
.stats b{display:block;font-family:var(--serif);font-weight:400;font-size:clamp(32px,3.6vw,48px);line-height:1;color:var(--pink)}
.stats span{font-size:13px;color:var(--pmute)}
@media (max-width:860px){.pf-about .wrap{grid-template-columns:1fr}.ink{max-width:300px;margin:-40px auto 0}.stats{grid-template-columns:1fr 1fr 1fr}}
@media (max-width:420px){.stats{grid-template-columns:1fr 1fr}}

/* ---------- skills ---------- */
.pf-skills{position:relative;padding:clamp(150px,16vw,230px) 0 clamp(60px,8vw,110px);overflow:hidden}
.pf-skills .wrap{position:relative;z-index:2;display:grid;grid-template-columns:.8fr 1.6fr;gap:clamp(24px,5vw,70px);align-items:center}
.pf-skills h2,.pf-work h2,.pf-proof h2{font-size:clamp(32px,4.2vw,56px);line-height:1.05;margin-bottom:18px}
.tiles{display:grid;grid-template-columns:1fr 1.25fr 1fr 1fr;grid-template-rows:auto auto;gap:clamp(10px,1.4vw,18px);perspective:1400px;align-items:center}
.tile{position:relative;border-radius:20px;padding:16px;min-height:118px;display:flex;flex-direction:column;justify-content:space-between;
  background:linear-gradient(160deg,rgba(20,60,66,.75),rgba(6,24,28,.85));border:1px solid var(--line2);
  box-shadow:0 30px 50px -30px rgba(0,0,0,.9),inset 0 1px 0 rgba(255,255,255,.06);
  transform:translateY(calc(var(--off,0px) + var(--sy2,0)*var(--dp,0)*-40px)) translateZ(calc(var(--dp,0)*20px)) rotateX(calc(var(--my,0)*var(--dp,1)*.5deg)) rotateY(calc(var(--mx,0)*var(--dp,1)*.5deg));
  animation:float 6s ease-in-out infinite;animation-delay:calc(var(--k)*-.9s);transition:border-color .3s,box-shadow .3s}
.tile:hover{border-color:var(--cyan);box-shadow:0 30px 60px -20px rgba(118,251,238,.35)}
@keyframes float{50%{translate:0 -8px}}
.tile .ic{width:34px;height:34px;border-radius:11px;display:grid;place-items:center;background:rgba(118,251,238,.1);color:var(--cyan)}
.tile .ic svg{width:18px}
.tile b{font-family:var(--disp);font-size:15px;display:block;margin-top:12px}
.tile small{color:var(--mute);font-size:11.5px;line-height:1.4}
.tile .dot{position:absolute;top:14px;right:14px;width:7px;height:7px;border-radius:50%;background:#4ade80;box-shadow:0 0 10px #4ade80}
.tile.big{grid-column:2;grid-row:1/span 2;min-height:300px;align-items:center;justify-content:center;text-align:center;
  background:radial-gradient(80% 60% at 50% 30%,rgba(118,251,238,.22),transparent 70%),linear-gradient(160deg,rgba(20,70,76,.85),rgba(6,24,28,.9));border-color:rgba(118,251,238,.5);
  box-shadow:0 0 0 1px rgba(118,251,238,.2),0 40px 80px -30px rgba(118,251,238,.45)}
.tile.big .ic{width:84px;height:84px;border-radius:26px;background:var(--grad);color:var(--on-accent);box-shadow:0 20px 50px -10px rgba(118,251,238,.7)}
.tile.big .ic svg{width:44px}
.tile.big b{font-size:24px;margin-top:22px}
.tile.big small{font-size:13px;margin-top:6px}
.tile.big .glowbar{width:70%;height:4px;border-radius:4px;background:var(--grad);margin-top:18px;box-shadow:0 0 18px rgba(118,251,238,.6)}
@media (max-width:1000px){.pf-skills .wrap{grid-template-columns:1fr}}
@media (max-width:640px){.tiles{grid-template-columns:1fr 1fr}.tile.big{grid-column:1/span 2;grid-row:auto;min-height:220px;order:-1}.tile{transform:none;min-height:110px}}

/* ---------- work carousel ---------- */
.pf-work{position:relative;padding:clamp(40px,6vw,80px) 0 clamp(150px,16vw,220px)}
.pf-work .head{display:grid;grid-template-columns:.75fr 1.25fr;gap:40px;align-items:end;margin-bottom:10px}
.pf-work .head p{max-width:360px}
.pf-work h2 .slash{color:var(--dim);font-weight:300;margin-left:8px}
.car{position:relative}
.track{display:flex;gap:clamp(14px,2vw,22px);overflow-x:auto;scroll-snap-type:x mandatory;padding:50px max(var(--pad),calc((100vw - var(--max))/2 + var(--pad))) 40px;
  scrollbar-width:none;perspective:1400px}
.track::-webkit-scrollbar{display:none}
.pc{--o:0;flex:0 0 clamp(250px,24vw,310px);scroll-snap-align:center;border-radius:24px;overflow:hidden;display:flex;flex-direction:column;
  background:linear-gradient(170deg,rgba(16,52,58,.85),rgba(6,22,26,.92));border:1px solid var(--line2);
  transform:rotateY(calc(var(--o)*-16deg)) translateZ(calc(var(--a,0)*-80px)) scale(calc(1 - var(--a,0)*.06));transition:border-color .3s,box-shadow .3s;
  box-shadow:0 40px 60px -40px rgba(0,0,0,.9)}
.pc:hover{border-color:var(--cyan);box-shadow:0 40px 70px -30px rgba(118,251,238,.35)}
.pc-v{position:relative;height:clamp(190px,17vw,220px);overflow:hidden;background:radial-gradient(80% 70% at 50% 30%,rgba(118,251,238,.16),transparent 70%),#0a2226}
.pc-v img{width:100%;height:100%;object-fit:cover;object-position:left top;transition:transform .6s}
.pc:hover .pc-v img{transform:scale(1.06)}
.pc-b{padding:18px 20px 20px;display:flex;flex-direction:column;gap:8px;flex:1}
.pc-b .tg{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--mint);font-weight:600}
.pc-b h3{font-size:20px}
.pc-b p{font-size:14px}
.pc-b .pl{display:flex;flex-wrap:wrap;gap:6px;margin-top:auto;padding-top:8px}
.pc-b .pl span{font-size:11px;padding:4px 9px;border-radius:999px;background:rgba(118,251,238,.08);color:var(--mint)}
.arrows{position:absolute;right:max(var(--pad),calc((100vw - var(--max))/2 + var(--pad)));top:-56px;display:flex;gap:8px}
.arrows button{width:44px;height:44px;border-radius:50%;border:1px solid var(--line2);background:rgba(255,255,255,.03);color:var(--ink);cursor:pointer;font-size:18px;transition:background .2s}
.arrows button:hover{background:var(--grad);color:var(--on-accent)}
/* mini UIs inside project cards */
.mini{position:absolute;inset:0;display:grid;place-items:center}
.m-cam{width:120px;height:120px;border-radius:50%;border:2px solid var(--cyan);background:radial-gradient(circle at 50% 42%,#2a6b75,#0b3038);position:relative;box-shadow:0 0 50px rgba(118,251,238,.3)}
.m-cam::before{content:"";position:absolute;left:22px;right:22px;top:44px;height:20px;border-radius:9px 9px 12px 12px;border:3px solid #e8fbff;border-top-width:4px}
.m-cam::after{content:"";position:absolute;inset:-14px;border-radius:50%;border:1px dashed rgba(118,251,238,.5);animation:spin 12s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.m-live{position:absolute;top:16px;right:16px;font-size:10px;font-weight:700;padding:4px 9px;border-radius:999px;background:var(--grad);color:var(--on-accent)}
.m-cart{width:84%;display:grid;gap:10px}
.m-cart .pop{border-radius:16px;padding:12px;background:rgba(9,30,34,.9);border:1px solid var(--line2);display:flex;gap:8px}
.m-cart .pop i{flex:1;height:30px;border-radius:9px;border:1px solid var(--line2);display:grid;place-items:center;font-style:normal;font-size:11px;color:var(--mute)}
.m-cart .pop i.s{border-color:var(--cyan);color:var(--ink);background:rgba(118,251,238,.1)}
.m-cart .pill{display:flex;justify-content:space-between;align-items:center;padding:8px 8px 8px 16px;border-radius:999px;background:rgba(9,30,34,.9);border:1px solid var(--line2);font-size:12px}
.m-cart .pill span{background:var(--grad);color:var(--on-accent);border-radius:999px;padding:7px 14px;font-weight:700}
.m-chat{width:82%;display:grid;gap:8px;font-size:11.5px}
.m-chat p{padding:9px 12px;border-radius:14px;max-width:85%;line-height:1.35}
.m-chat .u{justify-self:end;background:var(--grad);color:var(--on-accent);border-bottom-right-radius:4px}
.m-chat .b{background:rgba(255,255,255,.06);border:1px solid var(--line);color:var(--ink);border-bottom-left-radius:4px}
@media (max-width:760px){.pf-work .head{grid-template-columns:1fr;gap:0}.arrows{display:none}}

/* ---------- journey ---------- */
.pf-journey{padding:clamp(40px,6vw,80px) 0 clamp(50px,7vw,90px)}
.pf-journey .wrap{display:grid;grid-template-columns:.7fr 1.6fr;gap:clamp(24px,5vw,60px);align-items:center}
.pf-journey h2{font-size:clamp(32px,4.2vw,56px);line-height:1.05;color:var(--pink)}
.jr{position:relative;display:grid;grid-template-columns:repeat(4,1fr);gap:18px;padding-top:24px}
.jr svg.path{position:absolute;left:0;right:0;top:0;width:100%;height:60px;overflow:visible}
.jr svg.path path{fill:none;stroke:rgba(13,148,136,.35);stroke-width:2;stroke-dasharray:4 7}
.jr svg.path path.fill{stroke:#0d9488;stroke-dasharray:none;stroke-width:2.5;stroke-dashoffset:calc(1000 - var(--jp,0)*1000);stroke-dasharray:1000}
.js{position:relative;padding-top:56px}
.js .n{position:absolute;top:0;left:0;width:48px;height:48px;border-radius:50%;display:grid;place-items:center;background:#fff;color:#0b2b2d;border:1px solid rgba(13,148,136,.25);
  box-shadow:0 14px 30px -14px rgba(8,42,44,.4);transition:background .4s,color .4s,box-shadow .4s,transform .4s}
.js .n svg{width:20px}
.js.on .n{background:var(--pgrad);color:#fff;box-shadow:0 0 0 6px rgba(13,148,136,.14),0 16px 34px -10px rgba(13,148,136,.7);transform:scale(1.08)}
.js small{display:block;font-size:12px;font-weight:600;letter-spacing:.1em;color:var(--pteal);margin:12px 0 4px}
.js h4{font-family:var(--disp);font-size:17px;color:var(--pink);margin-bottom:6px}
.js p{font-size:13.5px;line-height:1.5}
@media (max-width:960px){.pf-journey .wrap{grid-template-columns:1fr}}
@media (max-width:640px){.jr{grid-template-columns:1fr;gap:22px;padding:0 0 0 64px}.jr svg.path{display:none}.jr::before{content:"";position:absolute;left:23px;top:10px;bottom:10px;width:2px;background:repeating-linear-gradient(to bottom,rgba(13,148,136,.4) 0 4px,transparent 4px 11px)}
  .js{padding-top:0}.js .n{left:-64px}.js small{margin-top:0}}

/* ---------- proof ---------- */
.pf-proof{position:relative;padding:clamp(150px,16vw,230px) 0 clamp(150px,16vw,230px);overflow:hidden}
.pf-proof .wrap{position:relative;z-index:2;display:grid;grid-template-columns:.7fr 1.5fr;gap:clamp(24px,5vw,60px);align-items:center}
.stage3{position:relative;height:clamp(300px,26vw,340px);perspective:1400px}
.qc{position:absolute;left:50%;top:50%;width:min(92%,400px);padding:clamp(22px,2.4vw,32px);border-radius:26px;
  background:linear-gradient(170deg,rgba(16,52,58,.9),rgba(6,22,26,.95));border:1px solid var(--line2);
  transform:translate(-50%,-50%) translateX(calc(var(--p)*62%)) translateZ(calc(var(--ap)*-180px)) rotateY(calc(var(--p)*-24deg));
  opacity:calc(1 - var(--ap)*.55);filter:blur(calc(var(--ap)*2px));transition:transform .7s cubic-bezier(.2,.8,.2,1),opacity .6s,filter .6s,box-shadow .6s;cursor:pointer}
.qc.on{box-shadow:0 0 0 1px rgba(118,251,238,.35),0 40px 90px -30px rgba(118,251,238,.4);cursor:default}
.qc .mark{font-family:var(--serif);font-size:64px;line-height:.6;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;display:block;height:30px}
.qc blockquote{margin:14px 0 18px;font-size:clamp(16px,1.5vw,19px);line-height:1.5;color:var(--ink)}
.qc .who2{display:flex;align-items:center;gap:12px;font-size:13px}
.qc .who2 i{width:36px;height:36px;border-radius:50%;background:var(--grad);display:grid;place-items:center;color:var(--on-accent);font-style:normal;font-weight:800;font-size:12px}
.qc .who2 b{display:block;font-family:var(--disp);color:var(--ink)}
.qc .who2 small{color:var(--mute)}
.qdots{display:flex;gap:8px;justify-content:center;margin-top:10px}
.qdots button{width:8px;height:8px;border-radius:50%;border:0;background:var(--dim);cursor:pointer;padding:0;transition:width .3s,background .3s}
.qdots button.on{width:26px;border-radius:5px;background:var(--cyan)}
@media (max-width:960px){.pf-proof .wrap{grid-template-columns:1fr}.stage3{height:340px}}

/* ---------- CTA ---------- */
.pf-cta{padding:clamp(40px,6vw,70px) 0 clamp(60px,8vw,100px)}
.pf-cta .wrap{display:grid;grid-template-columns:.9fr .9fr 1.1fr;gap:clamp(20px,4vw,50px);align-items:center}
.pf-cta h2{font-size:clamp(36px,5vw,64px);line-height:1.02;color:var(--pink)}
.pf-cta p{margin-bottom:22px;max-width:320px}
.btn-dark{display:inline-flex;align-items:center;gap:10px;padding:14px 26px;border-radius:999px;background:#082a2c;color:#e8fbff;font-weight:600;font-size:15px;box-shadow:0 18px 40px -16px rgba(8,42,44,.7);transition:transform .25s}
.btn-dark:hover{transform:translateY(-2px)}
.obj{position:relative;height:clamp(240px,24vw,320px);perspective:1100px;display:grid;place-items:center}
.obj .base{position:absolute;bottom:4%;width:90%;aspect-ratio:3.2;border-radius:50%;transform:rotateX(0)}
.obj .base i{position:absolute;inset:0;border-radius:50%;border:1.5px solid rgba(13,148,136,.45);animation:ripple 3.6s ease-out infinite;animation-delay:calc(var(--n)*-1.2s)}
@keyframes ripple{from{transform:scale(.4);opacity:1}to{transform:scale(1.1);opacity:0}}
.obj .glow{position:absolute;bottom:10%;width:44%;aspect-ratio:3;border-radius:50%;background:radial-gradient(circle,rgba(13,148,136,.55),transparent 70%);filter:blur(8px)}
.cube{position:relative;width:clamp(110px,11vw,150px);aspect-ratio:1;transform-style:preserve-3d;margin-bottom:12%;
  transform:rotateX(-22deg) rotateY(calc(var(--cy,0)*1deg));animation:hover 5s ease-in-out infinite}
@keyframes hover{50%{translate:0 -10px}}
.cube .f{position:absolute;inset:0;border-radius:22px;display:grid;place-items:center;font-family:var(--serif);font-style:italic;font-size:clamp(48px,5vw,66px);color:#fff;
  background:linear-gradient(145deg,rgba(45,212,191,.95),rgba(13,148,136,.85) 55%,rgba(8,42,44,.9));border:1px solid rgba(255,255,255,.5);box-shadow:inset 0 0 40px rgba(255,255,255,.25)}
.cube .f1{transform:translateZ(calc(clamp(110px,11vw,150px)/2))}
.cube .f2{transform:rotateY(90deg) translateZ(calc(clamp(110px,11vw,150px)/2))}
.cube .f3{transform:rotateY(180deg) translateZ(calc(clamp(110px,11vw,150px)/2))}
.cube .f4{transform:rotateY(-90deg) translateZ(calc(clamp(110px,11vw,150px)/2))}
.cube .f5{transform:rotateX(90deg) translateZ(calc(clamp(110px,11vw,150px)/2));background:linear-gradient(145deg,#7ff5e6,#2dd4bf)}
.cube .f6{transform:rotateX(-90deg) translateZ(calc(clamp(110px,11vw,150px)/2));background:#08393b}
@media (max-width:900px){.pf-cta .wrap{grid-template-columns:1fr}.obj{order:-1;height:240px}}

@media (prefers-reduced-motion:reduce){.ribbons *,.tile,.badge,.cube,.obj .base i,.ink-c::before,.ink-c::after,.m-cam::after{animation:none!important}}
</style>
</Fragment>

<div class="pf">

<nav class="side-dots" aria-label="Sections" id="sideDots">
  <a href="#pf-top" aria-label="Intro" class="on"></a><a href="#pf-about" aria-label="About"></a><a href="#pf-skills" aria-label="Skills"></a>
  <a href="#pf-work" aria-label="Work"></a><a href="#pf-journey" aria-label="Process"></a><a href="#pf-proof" aria-label="Proof"></a><a href="#pf-cta" aria-label="Contact"></a>
</nav>

<!-- ================= HERO ================= -->
<header class="pf-hero" id="pf-top">
