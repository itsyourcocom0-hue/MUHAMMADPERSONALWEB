        <div class="pd-btn b">BUY NOW</div>
        <div class="pd-trust"><span>✓ Cash on delivery</span><span>✓ Secure</span></div>
      </div></div>

      <div class="badge"><div><b>3,295 purchases</b><small>one ad account · Rs 748 each</small></div></div>
