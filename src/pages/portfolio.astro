  <svg class="wv wv-b" viewBox="0 0 1440 150" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0 L1440 0 L1440 40 C 1260 120, 1040 150, 820 90 C 600 30, 360 10, 160 90 C 90 118, 40 130, 0 120 Z"/></svg>
</section>

<!-- ================= SKILLS (dark) ================= -->
<section class="pf-skills" id="pf-skills">
  <div class="ribbons" aria-hidden="true">
    <svg viewBox="0 0 1440 700" preserveAspectRatio="xMidYMid slice"><g class="g"><g class="r2">
      <path d="M-100 520 C 300 380, 640 640, 980 420 S 1440 260, 1600 320" stroke="url(#rg1)" stroke-width="2"/>
      <path d="M-100 560 C 320 420, 660 690, 1000 470 S 1460 300, 1600 370" stroke="url(#rg2)" stroke-width="1"/>
      <path d="M-100 520 C 300 380, 640 640, 980 420 S 1440 260, 1600 320" stroke="url(#rg1)" stroke-width="60" opacity=".12" filter="url(#glw)"/></g></g></svg>
