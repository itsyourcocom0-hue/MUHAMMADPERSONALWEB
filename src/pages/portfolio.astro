        <div class="ph-chart"><small>Website purchases</small><b>3,295</b>
          <svg viewBox="0 0 200 56" preserveAspectRatio="none"><defs><linearGradient id="sp" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#76fbee" stop-opacity=".45"/><stop offset="1" stop-color="#76fbee" stop-opacity="0"/></linearGradient></defs>
            <path d="M0 46 C 20 40, 30 44, 45 34 S 70 38, 85 26 S 110 34, 125 20 S 150 26, 165 12 S 190 14, 200 6 L200 56 L0 56Z" fill="url(#sp)"/>
            <path d="M0 46 C 20 40, 30 44, 45 34 S 70 38, 85 26 S 110 34, 125 20 S 150 26, 165 12 S 190 14, 200 6" fill="none" stroke="#76fbee" stroke-width="2"/></svg></div>
        <div class="ph-row"><div class="ph-tile"><small>Cost / purchase</small><b>Rs 748</b></div><div class="ph-tile"><small>Account CTR</small><b>4.20%</b></div></div>
        <div class="ph-white"><div><small>Top creative CTR</small><b>5.50%</b></div><em>Kept ↑</em></div>
        <div class="ph-nav"><i></i><i></i><i></i><i></i></div>
      </div></div>

      <!-- phone B: mobile product page -->
      <div class="phone ph-b"><div class="scr"><div class="notch"></div>
        <div class="sb"><span>9:41</span><span>•••</span></div>
        <div class="pd-img">
          <svg viewBox="0 0 120 50" fill="none"><path d="M6 18h44l-4 18a10 10 0 0 1-10 8H22a10 10 0 0 1-10-8z" fill="#273235"/><path d="M70 18h44l-4 18a10 10 0 0 1-10 8H86a10 10 0 0 1-10-8z" fill="#273235"/><path d="M6 18h44M70 18h44M50 22c6-4 14-4 20 0" stroke="#c9a64a" stroke-width="3"/></svg>
