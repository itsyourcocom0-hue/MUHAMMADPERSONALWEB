  </div>
</header>

<!-- ================= ABOUT (light) ================= -->
<section class="light pf-about" id="pf-about">
  <svg class="wv wv-t" viewBox="0 0 1440 150" preserveAspectRatio="none" aria-hidden="true"><path d="M0 150 L0 70 C 180 10, 420 0, 640 60 C 860 120, 1100 150, 1300 80 C 1370 55, 1410 30, 1440 20 L1440 150 Z"/></svg>
  <div class="wrap">
    <div class="ink" id="ink">
      <div class="ink-c" id="inkC"><span class="ink-mono">MF</span></div>
      <i class="drop d1"></i><i class="drop d2"></i><i class="drop d3"></i>
    </div>
    <div>
      <span class="eb">About me</span>
      <h2><span class="serif">Code is my toolkit.</span><span class="serif">The funnel is my</span> <span class="it">craft.</span></h2>
