</section>

<!-- ================= WORK CAROUSEL (dark) ================= -->
<section class="pf-work" id="pf-work">
  <div class="wrap head">
    <div>
      <span class="eb">Featured work</span>
      <h2>Mobile experiences<span class="slash">/</span><br />that <span class="it">convert.</span></h2>
    </div>
