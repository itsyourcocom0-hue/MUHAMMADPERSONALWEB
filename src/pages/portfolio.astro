        <linearGradient id="rg2" x1="0" x2="1"><stop offset="0" stop-color="#76fbee" stop-opacity="0"/><stop offset=".5" stop-color="#2dd4bf" stop-opacity=".6"/><stop offset="1" stop-color="#14b8a6" stop-opacity="0"/></linearGradient>
        <filter id="glw" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="10"/></filter>
