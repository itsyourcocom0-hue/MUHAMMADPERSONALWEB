</section>

<!-- ================= JOURNEY (light) ================= -->
<section class="light pf-journey" id="pf-journey">
  <svg class="wv wv-t" viewBox="0 0 1440 150" preserveAspectRatio="none" aria-hidden="true"><path d="M0 150 L0 30 C 200 110, 460 140, 700 80 C 940 20, 1180 10, 1440 90 L1440 150 Z"/></svg>
  <div class="wrap">
    <div>
      <span class="eb">How it works</span>
      <h2>The journey of <span class="it">every project.</span></h2>
    </div>
    <div class="jr" id="jr">
      <svg class="path" viewBox="0 0 1000 60" preserveAspectRatio="none" aria-hidden="true">
        <path d="M24 24 C 150 4, 250 44, 374 24 S 600 4, 624 24 S 850 44, 976 24"/>
        <path class="fill" d="M24 24 C 150 4, 250 44, 374 24 S 600 4, 624 24 S 850 44, 976 24"/>
      </svg>
      {journey.map((j) => (
        <div class="js">
          <span class="n"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={j.d} /></span>
          <small>STEP {j.n}</small><h4>{j.t}</h4><p>{j.x}</p>
        </div>
      ))}
    </div>
  </div>
  <svg class="wv wv-b" viewBox="0 0 1440 150" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0 L1440 0 L1440 100 C 1200 30, 980 20, 760 80 C 540 140, 280 150, 0 60 Z"/></svg>
</section>

<!-- ================= PROOF (dark) ================= -->
<section class="pf-proof" id="pf-proof">
  <div class="ribbons" aria-hidden="true">
    <svg viewBox="0 0 1440 700" preserveAspectRatio="xMidYMid slice"><g class="g"><g class="r3">
      <path d="M-100 380 C 260 240, 620 520, 960 340 S 1440 180, 1600 260" stroke="url(#rg2)" stroke-width="1.4"/>
      <path d="M-100 380 C 260 240, 620 520, 960 340 S 1440 180, 1600 260" stroke="url(#rg1)" stroke-width="70" opacity=".1" filter="url(#glw)"/></g></g></svg>
  </div>
  <div class="wrap">
    <div>
      <span class="eb" id="proofEb">Proof</span>
      <h2 id="proofH">Results, not <span class="it">promises.</span></h2>
      <p id="proofP">Numbers straight from the work — no rounded-up guesses.</p>
    </div>
    <div>
      <div class="stage3" id="stage3">
        {proof.map((p, i) => (
          <article class="qc" data-i={i}>
            <span class="mark">“</span>
            <blockquote>{p.q}</blockquote>
            <div class="who2"><i>MF</i><div><b>{p.k}</b><small>From the build log</small></div></div>
          </article>
        ))}
      </div>
      <div class="qdots" id="qdots">{proof.map((_, i) => <button type="button" aria-label={`Show ${i + 1}`}></button>)}</div>
    </div>
  </div>
</section>

<!-- ================= CTA (light) ================= -->
<section class="light pf-cta" id="pf-cta">
  <svg class="wv wv-t" viewBox="0 0 1440 150" preserveAspectRatio="none" aria-hidden="true"><path d="M0 150 L0 90 C 240 20, 520 10, 760 70 C 1000 130, 1240 120, 1440 40 L1440 150 Z"/></svg>
  <div class="wrap">
    <div>
      <span class="eb">Let's work together</span>
      <h2>Have a <span class="it">store</span><br />in mind?</h2>
    </div>
    <div>
      <p>Send me the store link. I'll tell you which layer I'd look at first — ads, product page, cart or delivery.</p>
      <a class="btn-dark" href={wa} target={wa.startsWith('http') ? '_blank' : undefined} rel="noopener">Let's talk <span aria-hidden="true">➤</span></a>
    </div>
    <div class="obj" id="obj" aria-hidden="true">
      <div class="base"><i style="--n:0"></i><i style="--n:1"></i><i style="--n:2"></i></div>
      <div class="glow"></div>
      <div class="cube" id="cube"><div class="f f1">MF</div><div class="f f2">MF</div><div class="f f3">MF</div><div class="f f4">MF</div><div class="f f5"></div><div class="f f6"></div></div>
    </div>
  </div>
</section>

</div>

<script is:inline>
/* =========================================================
   PF CONFIG — portrait photo + real client testimonials.
   Testimonials empty = the section shows real results instead.
   Example: { quote: "…", name: "Ali Khan", role: "Founder, brand" }
   ========================================================= */
var PF = {
  portrait: "",          // e.g. "/images/portrait.jpg" (square photo works best)
  testimonials: []
};

(function () {
  var RM = matchMedia('(prefers-reduced-motion: reduce)').matches;
  var fine = matchMedia('(hover: hover) and (min-width: 1025px)').matches;
  var clamp = function (v, a, b) { return Math.min(b, Math.max(a, v)); };

  /* portrait */
  if (PF.portrait) {
    var c = document.getElementById('inkC'), im = new Image();
    im.src = PF.portrait; im.alt = 'Muhammad Farooqui'; im.decoding = 'async';
    c.appendChild(im); c.classList.add('has-img');
  }

  /* testimonials replace proof cards when provided */
  if (PF.testimonials.length) {
    var st = document.getElementById('stage3'), dots = document.getElementById('qdots');
    st.innerHTML = ''; dots.innerHTML = '';
    PF.testimonials.forEach(function (t, i) {
      var a = document.createElement('article'); a.className = 'qc'; a.dataset.i = i;
      var ini = t.name.split(' ').map(function (w) { return w[0]; }).join('').slice(0, 2).toUpperCase();
      a.innerHTML = '<span class="mark">“</span><blockquote></blockquote><div class="who2"><i></i><div><b></b><small></small></div></div>';
      a.querySelector('blockquote').textContent = t.quote; a.querySelector('i').textContent = ini;
      a.querySelector('b').textContent = t.name; a.querySelector('small').textContent = t.role || '';
      st.appendChild(a);
      var d = document.createElement('button'); d.type = 'button'; d.setAttribute('aria-label', 'Show ' + (i + 1)); dots.appendChild(d);
    });
    document.getElementById('proofEb').textContent = 'Testimonials';
    document.getElementById('proofH').innerHTML = 'People <span class="it">love</span> working with me.';
    document.getElementById('proofP').textContent = 'In their own words.';
  }

  /* proof / testimonial 3D carousel */
  var cards = [].slice.call(document.querySelectorAll('.qc')), qd = [].slice.call(document.querySelectorAll('#qdots button'));
  var cur = Math.min(1, cards.length - 1), n = cards.length;
  function show(i) {
    cur = (i + n) % n;
    cards.forEach(function (c, k) {
      var p = k - cur; if (p > n / 2) p -= n; if (p < -n / 2) p += n;
      c.style.setProperty('--p', p); c.style.setProperty('--ap', Math.abs(p)); c.style.zIndex = 10 - Math.abs(p);
      c.classList.toggle('on', p === 0);
    });
    qd.forEach(function (d, k) { d.classList.toggle('on', k === cur); });
  }
  cards.forEach(function (c, k) { c.addEventListener('click', function () { show(k); restart(); }); });
  qd.forEach(function (d, k) { d.addEventListener('click', function () { show(k); restart(); }); });
  var timer; function restart() { clearInterval(timer); if (!RM) timer = setInterval(function () { show(cur + 1); }, 5000); }
  if (n) { show(cur); restart(); }

  /* project carousel: coverflow tilt from position */
  var track = document.getElementById('track'), pcs = [].slice.call(track.querySelectorAll('.pc'));
  function flow() {
    var tr = track.getBoundingClientRect(), mid = tr.left + tr.width / 2;
    pcs.forEach(function (c) {
      var r = c.getBoundingClientRect(), o = clamp(((r.left + r.width / 2) - mid) / (tr.width / 2), -1.2, 1.2);
      c.style.setProperty('--o', o.toFixed(3)); c.style.setProperty('--a', Math.abs(o).toFixed(3));
    });
  }
  if (!RM) { track.addEventListener('scroll', function () { requestAnimationFrame(flow); }, { passive: true }); addEventListener('resize', flow); flow(); }
  var step = function () { return pcs[0].getBoundingClientRect().width + 20; };
  document.getElementById('prev').addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
  document.getElementById('next').addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
  /* start with the 2nd card centered on wide screens */
  if (innerWidth > 900) track.scrollLeft = 0;

  /* scroll-driven bits: journey path, skills parallax, cube spin, side dots */
  var jr = document.getElementById('jr'), jsteps = [].slice.call(jr.querySelectorAll('.js'));
  var tiles = document.getElementById('tiles'), skills = document.getElementById('pf-skills');
  var cube = document.getElementById('cube'), obj = document.getElementById('obj');
  var secs = ['pf-top', 'pf-about', 'pf-skills', 'pf-work', 'pf-journey', 'pf-proof', 'pf-cta'].map(function (id) { return document.getElementById(id); });
  var sdots = [].slice.call(document.querySelectorAll('#sideDots a'));
  var lastDot = -1;
  function upd() {
    var vh = innerHeight;
    var r = jr.getBoundingClientRect(), jp = clamp((vh * .85 - r.top) / (vh * .55), 0, 1);
    jr.style.setProperty('--jp', jp.toFixed(3));
    jsteps.forEach(function (s, i) { s.classList.toggle('on', jp >= (i + .5) / jsteps.length - .12); });
    var sr = skills.getBoundingClientRect();
    tiles.style.setProperty('--sy2', clamp((vh - sr.top) / (vh + sr.height), 0, 1).toFixed(3));
    var orr = obj.getBoundingClientRect();
    cube.style.setProperty('--cy', ((vh - orr.top) * .45).toFixed(1));
    var a = 0; secs.forEach(function (s, i) { if (s.getBoundingClientRect().top < vh * .45) a = i; });
    if (a !== lastDot) { sdots.forEach(function (d, i) { d.classList.toggle('on', i === a); }); lastDot = a; }
  }
  var tk = false; addEventListener('scroll', function () { if (!tk) { tk = true; requestAnimationFrame(function () { tk = false; upd(); }); } }, { passive: true });
  addEventListener('resize', upd); upd();

  /* mouse 3D: phones, skill tiles, portrait */
  if (fine && !RM) {
    var hook = function (host, target, amt) {
      host.addEventListener('mousemove', function (e) {
        var r = host.getBoundingClientRect();
        target.style.setProperty('--mx', (((e.clientX - r.left) / r.width - .5) * amt).toFixed(2));
        target.style.setProperty('--my', (((e.clientY - r.top) / r.height - .5) * -amt).toFixed(2));
      });
      host.addEventListener('mouseleave', function () { target.style.setProperty('--mx', 0); target.style.setProperty('--my', 0); });
    };
    var ph = document.getElementById('phones'); hook(ph.parentElement, ph, 16);
    hook(skills, tiles, 14);
    var ink = document.getElementById('ink'), inkC = document.getElementById('inkC');
    ink.addEventListener('mousemove', function (e) {
      var r = ink.getBoundingClientRect();
      inkC.style.setProperty('--ry', (((e.clientX - r.left) / r.width - .5) * 14).toFixed(2));
      inkC.style.setProperty('--rx', (((e.clientY - r.top) / r.height - .5) * -14).toFixed(2));
    });
    ink.addEventListener('mouseleave', function () { inkC.style.setProperty('--rx', 0); inkC.style.setProperty('--ry', 0); });
  }
})();
</script>
</Base>
