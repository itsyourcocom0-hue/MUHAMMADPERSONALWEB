          <path d="M-100 640 C 260 470, 520 820, 860 560 S 1380 260, 1600 360" stroke="url(#rg1)" stroke-width="3"/></g>
        <g class="r2"><path d="M-100 700 C 300 540, 560 860, 900 610 S 1400 330, 1600 430" stroke="url(#rg2)" stroke-width="1.6"/>
          <path d="M-100 730 C 320 580, 600 880, 940 650 S 1420 380, 1600 480" stroke="url(#rg2)" stroke-width="1"/></g>
        <g class="r3"><path d="M-100 300 C 300 180, 700 420, 1040 220 S 1500 120, 1600 160" stroke="url(#rg2)" stroke-width="1.2" opacity=".7"/>
          <path d="M600 900 C 820 700, 1060 760, 1240 560 S 1500 300, 1640 260" stroke="url(#rg1)" stroke-width="40" opacity=".14" filter="url(#glw)"/></g>
      </g>
    </svg>
  </div>

  <div class="wrap">
    <div>
      <span class="eb">E-Commerce Manager · Mobile-first</span>
      <h1>Building mobile stores <span class="grad-text">people</span> <span class="it">actually buy from.</span></h1>
      <p class="lead">Most of your customers shop on a phone. I design, code and run that whole mobile journey myself — from the ad they tap to the COD order at their door.</p>
      <div class="actions" style="margin:0">
