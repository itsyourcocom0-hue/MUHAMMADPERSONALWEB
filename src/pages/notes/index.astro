---
import Base from '../../layouts/Base.astro';
import Orbit from '../../components/Orbit.astro';
import Card from '../../components/Card.astro';
import CTA from '../../components/CTA.astro';
import { getCollection } from 'astro:content';
const notes = (await getCollection('notes')).sort((a, b) => a.data.order - b.data.order);
---
<Base
  title="E-Commerce Notes — From the Inside | Muhammad Farooqui"
  description="Practical frameworks from a working e-commerce manager: product-page audits, COD courier reconciliation and the unit economics beneath an order."
>
  <header class="pagehead">
    <Orbit hot={3} />
    <p class="eyebrow">Notes / The working notebook</p>
    <h1>Write down the work.<br /><em>Make it useful.</em></h1>
    <p class="lead">Practical frameworks for the storefront, the courier file and the numbers beneath an order.</p>
  </header>
  <section class="section">
    <div class="grid">
      {notes.map((n) => <Card href={`/notes/${n.id}`} eyebrow={n.data.pillar} title={n.data.title} text={n.data.lead} />)}
    </div>
  </section>
  <CTA />
</Base>
