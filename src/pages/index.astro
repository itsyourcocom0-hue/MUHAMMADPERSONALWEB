<script is:inline>
/* =========================================================
   CONFIG — sirf yahan apne links aur images ke path daalo.
   Khali ("") chhodoge to placeholder dikhega.
   ========================================================= */
const CONFIG = {
  calendly:  "",   // jab Calendly bane, link yahan   // e.g. https://calendly.com/your-link
  whatsapp:  "923111101577",   // e.g. 923001234567 (country code ke saath, + ke baghair)
  email:     "muhammad@farooqui-inc.com",   // e.g. you@domain.com
  linkedin:  "https://www.linkedin.com/in/muhammad-bin-yousuf-835208287/",   // full profile URL
  instagram: "https://www.instagram.com/its_cocom0/",   // full profile URL
  agency:    "https://farooqui-inc.com/",
  images: {
    portrait: "",  // /images/portrait.jpg
    tryon:    "",  // /images/tryon.jpg  (GIF bhi chalega)
    cart:     "",
    pdp:      "/images/pdp.webp",
    cards:    "/images/cards.webp",
    chatbot:  "",
    ads:      "/images/ads.webp"
  }
};

(function(){
  /* ---------- images ---------- */
  document.querySelectorAll('[data-img]').forEach(el=>{
    const src = CONFIG.images[el.dataset.img];
    if(!src){ const host = el.closest('.portrait'); if(host){ host.parentElement.classList.add('solo'); host.remove(); } else el.remove(); return; }
    const img = new Image();
    img.src = src; img.alt = el.dataset.alt || ''; img.loading = 'lazy'; img.decoding = 'async';
    el.appendChild(img); el.classList.add('has-img');
  });

  /* ---------- links ---------- */
  document.querySelectorAll('[data-link]').forEach(a=>{
    const k = a.dataset.link; let v = CONFIG[k];
    if(!v){ a.href = '#contact'; a.classList.add('pending'); return; }
    if(k==='email') v = 'mailto:' + v;
    if(k==='whatsapp') v = 'https://wa.me/' + v.replace(/\D/g,'');
    a.href = v;
    if(k!=='email'){ a.target = '_blank'; a.rel = 'noopener'; }
  });
  if(CONFIG.calendly){
    const box = document.getElementById('calendlyBox');
    box.innerHTML = '<iframe title="Book a call" loading="lazy" src="'+CONFIG.calendly+'?hide_gdpr_banner=1&background_color=06222a&text_color=e8fbff&primary_color=22d3ee"></iframe>';
    box.style.border = '0'; box.style.padding = '0';
  }

  /* ---------- helpers ---------- */
  const RM = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp = (v,a,b)=>Math.min(b,Math.max(a,v));
  const smooth = t=>t*t*(3-2*t);
  const secProgress = el=>{ const r = el.getBoundingClientRect(); const t = r.height - innerHeight; return t>0 ? clamp(-r.top/t,0,1) : 0; };

  const heroScene = document.getElementById('heroScene');
  const funnel = document.getElementById('funnel');
  const stack = document.getElementById('stack');
  const plates = [...stack.querySelectorAll('.plate')];
  const layerItems = [...document.querySelectorAll('#layersList li')];
  const skills = document.getElementById('skills');
  const wheel = document.getElementById('wheel');
  const tiles = [...wheel.querySelectorAll('.tile')];
  const panels = [...document.querySelectorAll('#panels .panel')];
  const dots = [...document.querySelectorAll('#dots i')];
  const tiltCards = [...document.querySelectorAll('[data-tilt3d]')];
  const steps = [...document.querySelectorAll('[data-step]')];
  const ribbon = document.getElementById('ribbon');
  const rbTracks = [...document.querySelectorAll('.rb-track')];
  const nodes = [...document.querySelectorAll('[data-node]')];

  let lastSkill = -1, lastLayer = -1;
  const setActive = (list,i)=>list.forEach((el,n)=>el.classList.toggle('on',n===i));

  function update(){
    ticking = false;

    if(RM){ setActive(panels,0); setActive(tiles,0); setActive(dots,0); return; }

    /* hero: device opens up on scroll, closes on scroll back */
    heroScene.style.setProperty('--sy', clamp(scrollY/(innerHeight*.9),0,1).toFixed(3));

    /* funnel: plates separate on scroll down, collapse on scroll up */
    const fp = secProgress(funnel);
    stack.style.setProperty('--p', fp.toFixed(3));
    funnel.style.setProperty('--p', fp.toFixed(3));
    const li = Math.min(5, Math.floor(fp*6));
    if(li!==lastLayer){ setActive(plates,li); setActive(layerItems,li); lastLayer = li; }

    /* skills: wheel turns 72° per skill, pauses on each, reverses on scroll up */
    const sp = secProgress(skills);
    const raw = sp*4.0;                       // 0..4  (5 skills)
    const base = Math.floor(raw), f = raw - base;
    const eased = Math.min(4, base + smooth(clamp((f-.3)/.4,0,1)));  // hold → turn → hold
    wheel.style.setProperty('--a', (-eased*72).toFixed(2));
    const si = Math.round(eased);
    if(si!==lastSkill){ setActive(tiles,si); setActive(panels,si); setActive(dots,si); lastSkill = si; }

    /* build-log cards rise/flip in, and flip back out when scrolling up */
    const vh = innerHeight;
    tiltCards.forEach(c=>{
      const r = c.getBoundingClientRect();
      c.style.setProperty('--v', clamp((vh - r.top)/(vh*.55),0,1).toFixed(3));
    });
    nodes.forEach((s,i)=>{
      const r = s.getBoundingClientRect();
      s.style.setProperty('--v', clamp((vh - r.top - i*40)/(vh*.45),0,1).toFixed(3));
    });
    steps.forEach((s,i)=>{
      const r = s.getBoundingClientRect();
      s.style.setProperty('--v', clamp((vh - r.top - i*30)/(vh*.45),0,1).toFixed(3));
    });
    /* ribbon: both bands slide opposite ways with scroll, and back */
    const rr = ribbon.getBoundingClientRect();
    if(rr.bottom > -50 && rr.top < vh + 50){
      const loc = vh - rr.top;
      rbTracks[0].style.setProperty('--x', (-loc*0.55).toFixed(1));
      rbTracks[1].style.setProperty('--x', (-900 + loc*0.55).toFixed(1));
    }
  }
  let ticking = false;
  const req = ()=>{ if(!ticking){ ticking = true; requestAnimationFrame(update); } };
  addEventListener('scroll', req, {passive:true});
  addEventListener('resize', req);
  update();

  /* ---------- mouse tilt (desktop only) ---------- */
  const fine = matchMedia('(hover:hover) and (min-width:1025px)').matches;
  if(fine && !RM){
    heroScene.addEventListener('mousemove', e=>{
      const r = heroScene.getBoundingClientRect();
      heroScene.style.setProperty('--mx', (((e.clientX-r.left)/r.width - .5)*16).toFixed(2));
      heroScene.style.setProperty('--my', (((e.clientY-r.top)/r.height - .5)*-16).toFixed(2));
    });
    heroScene.addEventListener('mouseleave', ()=>{ heroScene.style.setProperty('--mx',0); heroScene.style.setProperty('--my',0); });

    const tilt = (host,target,amt)=>{
      host.addEventListener('mousemove', e=>{
        const r = host.getBoundingClientRect();
        target.style.setProperty('--ry', (((e.clientX-r.left)/r.width - .5)*amt).toFixed(2));
        target.style.setProperty('--rx', (((e.clientY-r.top)/r.height - .5)*-amt).toFixed(2));
      });
      host.addEventListener('mouseleave', ()=>{ target.style.setProperty('--rx',0); target.style.setProperty('--ry',0); });
    };
    tiltCards.forEach(c=>tilt(c, c.querySelector('.card-in'), 8));
    const pt = document.querySelector('[data-hover3d-target]');
    if(pt) tilt(pt, pt.querySelector('.media'), 10);
  }

  /* ---------- hero: words flip in one by one ---------- */
  const h1 = document.querySelector('.hero h1');
  if(h1 && !RM){
    let n = 0;
    const split = node=>{
      [...node.childNodes].forEach(ch=>{
        if(ch.nodeType===3){
          const frag = document.createDocumentFragment();
          ch.textContent.split(/(\s+)/).forEach(part=>{
            if(!part) return;
            if(/^\s+$/.test(part)){ frag.appendChild(document.createTextNode(' ')); return; }
            const s = document.createElement('span'); s.className = 'w'; s.style.setProperty('--i', n++); s.textContent = part; frag.appendChild(s);
          });
          ch.replaceWith(frag);
        } else if(ch.nodeType===1) split(ch);
      });
    };
    split(h1);
  }

  /* ---------- Funnel X-ray ---------- */
  const XR = [
    {t:'The ads', x:"People aren't clicking, so the offer, creative or audience isn't stopping the scroll. I'd start with a full account audit — creatives, audiences and where the budget is actually going."},
    {t:'The product page', x:"Traffic arrives but doesn't add to cart — the page isn't answering the buyer's doubts. I'd look at images, price clarity, delivery info and trust signals next to the buy button."},
    {t:'Cart & checkout', x:"Carts aren't becoming orders. Something adds friction: surprise shipping costs, variant errors or a slow mobile checkout. I'd walk the full journey on a phone first."},
    {t:'COD & delivery', x:"Orders come in but don't get delivered — refusals and fake orders eat the margin. I'd set up order confirmation before dispatch and courier reconciliation."}
  ];
  const ans = [null,null,null,null];
  const xrPlates = [...document.querySelectorAll('.xr-plate')];
  const xrQs = [...document.querySelectorAll('.xr-q')];
  const xrBox = document.getElementById('xrResult');
  const wa = msg => CONFIG.whatsapp ? 'https://wa.me/'+CONFIG.whatsapp.replace(/\D/g,'')+'?text='+encodeURIComponent(msg) : '#contact';
  const xr = ()=>{
    const leak = ans.indexOf('no'), done = ans.filter(Boolean).length;
    xrPlates.forEach((p,i)=>{
      p.classList.toggle('ok', ans[i]==='yes' && (leak<0 || i<leak));
      p.classList.toggle('leak', i===leak);
      p.classList.toggle('dim', leak>=0 && i>leak);
    });
    xrQs.forEach((q,i)=>{ q.classList.toggle('no', ans[i]==='no'); q.classList.toggle('yes', ans[i]==='yes'); });
    const tag = document.getElementById('xrTag'), ti = document.getElementById('xrTitle'), tx = document.getElementById('xrText'), cta = document.getElementById('xrCta');
    xrBox.classList.toggle('hot', leak>=0);
    cta.removeAttribute('target');
    if(leak>=0){
      tag.textContent = 'Likely leak'; ti.textContent = XR[leak].t; tx.textContent = XR[leak].x;
      cta.textContent = 'Send me this on WhatsApp →';
      cta.href = wa('Hi Muhammad, I ran the Funnel X-ray on your site. My likely leak: ' + XR[leak].t + '. My store: ');
      if(CONFIG.whatsapp){ cta.target = '_blank'; cta.rel = 'noopener'; }
    } else if(done===4){
      tag.textContent = 'All four hold'; ti.textContent = 'No obvious leak — time to scale';
      tx.textContent = "Your funnel holds at every layer. The next step is scaling ads without breaking what already works.";
      cta.textContent = 'Talk about scaling →';
      cta.href = wa('Hi Muhammad, I ran the Funnel X-ray — all four layers look fine and I want to scale. My store: ');
      if(CONFIG.whatsapp){ cta.target = '_blank'; cta.rel = 'noopener'; }
    } else {
      tag.textContent = 'Your result'; ti.textContent = done ? 'Keep going — ' + done + ' of 4' : 'Answer the four questions';
      tx.textContent = 'Your leak will light up on the stack.'; cta.textContent = 'Talk to me →'; cta.href = '#contact';
    }
  };
  xrQs.forEach((q,i)=> q.querySelectorAll('button').forEach(b=> b.addEventListener('click', ()=>{
    ans[i] = ans[i]===b.dataset.a ? null : b.dataset.a;
    q.querySelectorAll('button').forEach(x=> x.classList.toggle('sel', ans[i]===x.dataset.a));
    xr();
  })));
})();
</script>

</Base>
