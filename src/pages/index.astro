---
// Homepage — 3D scroll page on the shared layout (Base.astro).
// Links & images live in the CONFIG block of the script at the bottom.
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const notes = (await getCollection('notes')).sort((a, b) => a.data.order - b.data.order);
const faq = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "What does an e-commerce manager actually do?", "acceptedAnswer": {"@type": "Answer", "text": "An e-commerce manager owns the whole path from ad to delivered order: the ads that bring traffic, the store and product pages that convert it, the cart and checkout, and the operations behind cash-on-delivery orders. Instead of hiring a separate ad buyer, developer and CRO consultant, you get one person who sees how every layer affects the others."}}, {"@type": "Question", "name": "Will you make changes on my live store?", "acceptedAnswer": {"@type": "Answer", "text": "No. All work is built on a duplicate theme and shared with you through a preview link. Your live store stays untouched until you approve the changes."}}, {"@type": "Question", "name": "Can you work on my existing Shopify theme?", "acceptedAnswer": {"@type": "Answer", "text": "Yes, including older and heavily customised themes. New sections are hand-coded in Liquid with their own scoped CSS, so they fit into what you already have without breaking other pages."}}, {"@type": "Question", "name": "Do you do all the work yourself?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. The diagnosis, strategy, design and build are done by me. A small team at Farooqui Inc supports routine execution under my direction, but I am the one you deal with and the one accountable for the result."}}, {"@type": "Question", "name": "Do you work with stores outside Pakistan?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. The team covers both Pakistan and US business hours, so international clients get responses during their working day."}}, {"@type": "Question", "name": "Do you only run ads?", "acceptedAnswer": {"@type": "Answer", "text": "No. Ads are one layer. Many stores have ads that perform well but a website that loses the customer, so the work covers the store, product pages and cart as well."}}, {"@type": "Question", "name": "How do we start?", "acceptedAnswer": {"@type": "Answer", "text": "Book a call. The first step is an audit of your ads and store, followed by a written plan you approve before anything is built."}}]};
---
<Base
  title={"Muhammad Farooqui | E-Commerce Manager & Full-Funnel Expert"}
  description={"Muhammad Farooqui diagnoses your entire e-commerce funnel — ads, store, cart, COD — and fixes it himself. PKR 14 Cr+ ad spend managed."}
  ogType="profile"
  full
  schema={[faq]}
>
<Fragment slot="head">
<style is:inline>
.home{--glass:rgba(10,44,52,.55)}
.home :where(h1,h2,h3,h4,h5,p,ul,ol,li){margin:0;padding:0}
.home .sec-head h2{font-size:clamp(30px,4.6vw,58px);margin:14px 0 16px}
.home .sec-head p{font-size:clamp(15px,1.25vw,18px)}

/* ---------- hero ---------- */
.hero{min-height:100vh;display:grid;align-items:center;padding:120px 0 60px}
.hero-grid{display:grid;grid-template-columns:1.05fr 1fr;gap:clamp(24px,4vw,60px);align-items:center}
.hero h1{font-size:clamp(38px,6vw,82px);margin:18px 0 22px}
.hero p.lead{color:var(--mute);font-size:clamp(16px,1.35vw,19px);max-width:560px}
.hero p.lead b{color:var(--ink);font-weight:600}
.cta-row{display:flex;flex-wrap:wrap;gap:12px;margin:32px 0 28px}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{font-size:13px;padding:7px 14px;border-radius:999px;border:1px solid var(--line);color:var(--mute);background:rgba(255,255,255,.02)}
@media (max-width:960px){.hero-grid{grid-template-columns:1fr}.scene{order:-1;height:clamp(320px,92vw,440px);margin-bottom:28px}.device{width:min(64%,300px)}}

/* 3D device scene */
.scene{perspective:1400px;height:clamp(360px,46vw,560px);display:grid;place-items:center;--sy:0;--mx:0;--my:0}
.device{position:relative;width:min(88%,460px);aspect-ratio:4/5;transform-style:preserve-3d;
  transform:rotateX(calc(14deg + var(--sy)*16deg + var(--my)*1deg)) rotateY(calc(-20deg + var(--sy)*34deg + var(--mx)*1deg)) rotateZ(calc(4deg - var(--sy)*4deg));
  transition:transform .15s linear}
.layer{position:absolute;transform-style:preserve-3d;transform:translateZ(calc(var(--z)*1px*(1 + var(--sy)*1.4)))}
.screen{inset:0;border-radius:24px;background:linear-gradient(160deg,#0b3540,#061d23);border:1px solid var(--line2);box-shadow:0 60px 80px -40px rgba(0,0,0,.8),0 0 0 1px rgba(255,255,255,.03) inset;padding:18px;display:flex;flex-direction:column;gap:12px;--z:0}
.scr-bar{display:flex;gap:6px}.scr-bar span{width:9px;height:9px;border-radius:50%;background:var(--line2)}
.scr-img{flex:1;border-radius:14px;background:
  radial-gradient(60% 50% at 50% 55%,rgba(118,251,238,.35),transparent 70%),
  linear-gradient(140deg,#0f4651,#082a31);position:relative;overflow:hidden}
.scr-img svg{position:absolute;inset:0;margin:auto;width:58%;opacity:.9}
.scr-line{height:10px;border-radius:6px;background:var(--line2)}
.scr-line.w60{width:60%}.scr-line.w40{width:40%;background:rgba(94,234,212,.4)}
.scr-btn{height:40px;border-radius:12px;background:var(--grad);display:grid;place-items:center;color:#032026;font-weight:700;font-size:13px}
.float{border-radius:16px;background:rgba(9,40,47,.82);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border:1px solid var(--line2);padding:12px 14px;font-size:12px;box-shadow:0 30px 50px -20px rgba(0,0,0,.7);white-space:nowrap}
.float b{display:block;font-family:var(--disp);font-size:18px}
.float small{color:var(--mute)}
.f-try{top:12%;left:-14%;--z:110;display:flex;align-items:center;gap:10px}
.f-try .cam{width:46px;height:46px;border-radius:50%;background:radial-gradient(circle at 50% 40%,#2a6b75,#0b3038);position:relative;border:2px solid var(--cyan)}
.f-try .cam::after{content:"";position:absolute;left:8px;right:8px;top:17px;height:8px;border-radius:5px;border:2px solid var(--ink);border-top-width:3px}
.f-cart{bottom:16%;right:-12%;--z:150;display:flex;align-items:center;gap:10px;border-radius:999px;padding:10px 12px 10px 16px}
.f-cart .pill{background:var(--grad);color:#032026;border-radius:999px;padding:6px 12px;font-weight:700}
.f-ads{top:-6%;right:-6%;--z:80}
.bars{display:flex;align-items:flex-end;gap:4px;height:34px;margin-top:6px}
.bars i{width:8px;border-radius:3px;background:var(--grad);opacity:.9}
.f-cod{bottom:-5%;left:4%;--z:60;display:flex;gap:10px;align-items:center}
.f-cod svg{width:26px;color:var(--mint)}

/* ---------- proof strip ---------- */
.proof{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:rgba(6,34,42,.4)}
.proof .wrap{display:grid;grid-template-columns:repeat(4,1fr)}
.stat{padding:clamp(22px,3vw,38px) 12px;border-right:1px solid var(--line)}
.stat:last-child{border-right:0}
.stat b{display:block;font-family:var(--disp);font-size:clamp(26px,3.4vw,44px)}
.stat > span{color:var(--mute);font-size:clamp(12px,1vw,14px)}
@media (max-width:760px){.proof .wrap{grid-template-columns:1fr 1fr}.stat:nth-child(2){border-right:0}.stat:nth-child(-n+2){border-bottom:1px solid var(--line)}}

/* ---------- funnel explode (sticky) ---------- */
.funnel{height:300vh;position:relative;--p:0}
.funnel .stage{position:sticky;top:0;height:100vh;display:grid;align-items:center}
.funnel-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(20px,4vw,60px);align-items:center}
.stack-scene{perspective:1600px;height:min(70vh,560px);display:grid;place-items:center}
.stack{position:relative;width:min(78%,340px);aspect-ratio:1;transform-style:preserve-3d;
  transform:rotateX(58deg) rotateZ(calc(-42deg + var(--p)*24deg))}
.plate{position:absolute;inset:0;border-radius:22px;transform:translateZ(calc(var(--i)*(10px + var(--p)*62px)));
  background:linear-gradient(135deg,rgba(20,184,166,.20),rgba(118,251,238,.10));border:1px solid var(--line2);
  display:grid;place-items:center;font-family:var(--disp);font-weight:600;font-size:clamp(13px,1.4vw,17px);
  color:var(--ink);transition:background .35s,border-color .35s,box-shadow .35s;backdrop-filter:blur(2px)}
.plate.on{background:linear-gradient(135deg,rgba(20,184,166,.6),rgba(118,251,238,.45));border-color:var(--cyan);box-shadow:0 0 60px rgba(118,251,238,.35)}
.layers-list{list-style:none;display:grid;gap:10px;margin-top:26px}
.layers-list li{padding:14px 18px;border-radius:14px;border:1px solid var(--line);color:var(--mute);transition:all .35s;display:flex;gap:14px}
.layers-list li em{font-style:normal;font-family:var(--disp);color:var(--dim);min-width:26px}
.layers-list li.on{border-color:var(--cyan);background:rgba(118,251,238,.07);color:var(--ink);transform:translateX(8px)}
.layers-list li.on em{color:var(--cyan)}
@media (max-width:900px){
  .funnel-grid{grid-template-columns:1fr}
  .stack-scene{height:34vh}
  .layers-list{gap:6px;margin-top:12px}.layers-list li{padding:9px 14px;font-size:14px}
  .funnel .sec-head h2{font-size:26px}.funnel .sec-head p{display:none}
}

/* ---------- skills spinner (sticky) ---------- */
.skills{height:520vh;position:relative}
.skills .stage{position:sticky;top:0;height:100vh;display:grid;align-items:center;overflow:hidden}
.skills-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:clamp(20px,5vw,80px);align-items:center}
.wheel-scene{perspective:1300px;height:min(74vh,540px);display:grid;place-items:center;position:relative}
.wheel{--a:0;--tilt:58;position:relative;width:min(80%,400px);aspect-ratio:1;transform-style:preserve-3d;
  transform:rotateX(calc(var(--tilt)*1deg)) rotateZ(calc(var(--a)*1deg))}
.disc{position:absolute;inset:0;border-radius:50%;transform-style:preserve-3d}
.disc i{position:absolute;inset:0;border-radius:50%;
  background:conic-gradient(from -36deg,rgba(20,184,166,.32) 0 71deg,transparent 71deg 72deg,rgba(118,251,238,.18) 72deg 143deg,transparent 143deg 144deg,rgba(20,184,166,.32) 144deg 215deg,transparent 215deg 216deg,rgba(118,251,238,.18) 216deg 287deg,transparent 287deg 288deg,rgba(20,184,166,.32) 288deg 359deg,transparent 359deg);
  border:1px solid var(--line2);transform:translateZ(calc(var(--d)*-1px))}
.disc i:nth-child(n+2){background:rgba(8,40,47,.9);border-color:rgba(118,251,238,.2)}
.hub{position:absolute;inset:36%;border-radius:50%;background:radial-gradient(circle at 40% 35%,#1d6f78,#06232a);border:1px solid var(--cyan);transform:translateZ(18px);box-shadow:0 0 40px rgba(118,251,238,.4)}
.spoke{position:absolute;left:50%;top:50%;width:0;height:0;transform-style:preserve-3d;
  transform:translateZ(34px) rotateZ(calc(var(--k)*72deg)) translateY(calc(min(40vw,200px)*.78))}
.tile{position:absolute;width:clamp(64px,7vw,92px);height:clamp(64px,7vw,92px);left:calc(clamp(64px,7vw,92px)/-2);top:calc(clamp(64px,7vw,92px)/-2);
  transform:rotateZ(calc(-1deg*(var(--k)*72 + var(--a)))) rotateX(calc(var(--tilt)*-1deg)) translateZ(30px);
  border-radius:20px;background:rgba(8,38,45,.92);border:1px solid var(--line2);display:grid;place-items:center;
  transition:background .35s,border-color .35s,box-shadow .35s,scale .35s}
.tile svg{width:46%;color:var(--mute);transition:color .35s}
.tile.on{background:var(--grad);border-color:transparent;box-shadow:0 20px 50px -10px rgba(118,251,238,.75);scale:1.18}
.tile.on svg{color:#032026}
.pointer{position:absolute;bottom:4%;left:50%;transform:translateX(-50%);font-size:12px;color:var(--cyan);letter-spacing:.14em;text-transform:uppercase;display:flex;flex-direction:column;align-items:center;gap:4px}
.pointer::before{content:"";width:2px;height:22px;background:var(--grad);border-radius:2px}
.panels{position:relative;min-height:440px}
.panel{position:absolute;inset:0;opacity:0;transform:translateY(40px) rotateX(-12deg);transform-origin:50% 100%;transition:opacity .18s,transform .3s;pointer-events:none}
.panel.on{opacity:1;transform:none;pointer-events:auto;transition:opacity .4s .16s,transform .55s .16s}
.panel .num{font-family:var(--disp);color:var(--dim);font-size:14px}
.panel h3{font-size:clamp(28px,3.6vw,48px);margin:8px 0 14px}
.panel p{color:var(--mute);font-size:clamp(15px,1.2vw,17px);max-width:520px}
.panel ul{list-style:none;margin:20px 0;display:grid;gap:10px}
.panel li{display:flex;gap:12px;font-size:15px}
.panel li::before{content:"";flex:none;width:7px;height:7px;margin-top:9px;border-radius:2px;background:var(--grad);rotate:45deg}
.dots{display:flex;gap:8px;margin-top:8px}
.dots i{width:28px;height:4px;border-radius:4px;background:var(--line2);transition:background .35s,width .35s}
.dots i.on{background:var(--grad);width:48px}
@media (max-width:900px){
  .skills-grid{grid-template-columns:1fr;gap:0}
  .wheel-scene{height:36vh}
  .spoke{transform:translateZ(26px) rotateZ(calc(var(--k)*72deg)) translateY(28vw)}
  .wheel{width:min(70vw,300px)}
  .tile{width:54px;height:54px;left:-27px;top:-27px;border-radius:14px}
  .panels{min-height:52vh}
  .panel h3{font-size:26px;margin:4px 0 8px}
  .panel p{font-size:14px}.panel ul{margin:12px 0;gap:6px}.panel li{font-size:13.5px}
  .skills .sec-head{display:none}
}


/* ---------- how work gets done ---------- */
.flow{display:grid;grid-template-columns:1fr auto 1.4fr auto 1fr;gap:14px;align-items:stretch;perspective:1400px}
.flow-arrow{display:grid;place-items:center;color:var(--cyan);font-size:22px}
.node{--v:1;border-radius:var(--r);border:1px solid var(--line2);padding:26px;background:linear-gradient(160deg,rgba(20,184,166,.14),rgba(6,30,36,.6));
  transform:rotateY(calc((1 - var(--v))*-35deg)) translateZ(calc((1 - var(--v))*-200px));opacity:calc(.15 + var(--v)*.85)}
.node .who{margin:0 0 14px}
.node h4{font-size:21px;margin-bottom:8px}
.node p{color:var(--mute);font-size:14.5px}
.split{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.split > div{border-radius:16px;border:1px solid var(--line);padding:18px;background:rgba(4,22,27,.5)}
.split h5{font-family:var(--disp);font-size:16px;margin:10px 0 6px}
.split p{font-size:13.5px}
.split a{color:var(--cyan);font-size:13px;font-weight:600;display:inline-block;margin-top:8px}
@media (max-width:960px){.flow{grid-template-columns:1fr}.flow-arrow{transform:rotate(90deg)}.node{transform:rotateX(calc((1 - var(--v))*30deg)) translateZ(calc((1 - var(--v))*-160px))}}
@media (max-width:520px){.split{grid-template-columns:1fr}}

/* ---------- build log cards ---------- */
.cards{display:grid;grid-template-columns:repeat(2,1fr);gap:clamp(16px,2.4vw,28px)}
.bcard{--v:1;perspective:1200px}
.card-in{height:100%;border-radius:var(--r);background:linear-gradient(170deg,rgba(13,52,61,.7),rgba(6,30,36,.7));border:1px solid var(--line);
  overflow:hidden;transform-origin:50% 100%;--rx:0;--ry:0;
  transform:rotateX(calc((1 - var(--v))*26deg + var(--rx)*1deg)) rotateY(calc(var(--ry)*1deg)) translateY(calc((1 - var(--v))*80px)) scale(calc(.92 + var(--v)*.08));
  opacity:calc(.15 + var(--v)*.85);transition:border-color .3s;display:flex;flex-direction:column}
.card-in:hover{border-color:var(--line2)}
.card-body{padding:clamp(20px,2.4vw,32px);display:flex;flex-direction:column;gap:12px;flex:1}
.bcard .tag{font-size:12px;color:var(--mint);letter-spacing:.1em;text-transform:uppercase;font-weight:600}
.bcard h3{font-size:clamp(22px,2.2vw,30px)}
.bcard p{color:var(--mute);font-size:15px}
.bcard .how{list-style:none;display:grid;gap:8px;margin-top:4px;font-size:14px}
.bcard .how li{padding-left:18px;position:relative}
.bcard .how li::before{content:"→";position:absolute;left:0;color:var(--cyan)}
.pills{display:flex;flex-wrap:wrap;gap:6px;margin-top:auto;padding-top:10px}
.pills span{font-size:12px;padding:5px 10px;border-radius:999px;background:rgba(118,251,238,.08);color:var(--mint)}
.bcard.wide{grid-column:span 2}
.bcard.wide .card-in{flex-direction:row}
.bcard.wide .media{flex:1.1;aspect-ratio:auto;min-height:320px}
.bcard.wide .card-body{flex:1}
@media (max-width:860px){.cards{grid-template-columns:1fr}.bcard.wide{grid-column:auto}.bcard.wide .card-in{flex-direction:column}.bcard.wide .media{min-height:0;aspect-ratio:4/3}}


/* ---------- process (3D staircase) ---------- */
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;perspective:1400px}
.step{--v:1;padding:28px 22px;border-radius:var(--r);border:1px solid var(--line2);
  background:linear-gradient(160deg,rgba(20,184,166,.14),rgba(6,30,36,.6));
  transform:translateZ(calc((1 - var(--v))*-260px)) rotateY(calc((1 - var(--v))*-30deg)) translateY(calc(var(--n)*-14px*var(--v)));
  opacity:calc(.1 + var(--v)*.9)}
.step .n{font-family:var(--disp);font-size:48px;font-weight:700;line-height:1}
.step h4{font-size:20px;margin:14px 0 8px}
.step p{color:var(--mute);font-size:14.5px}
@media (max-width:900px){.steps{grid-template-columns:1fr 1fr}}
@media (max-width:560px){.steps{grid-template-columns:1fr}.step{transform:translateZ(calc((1 - var(--v))*-200px)) rotateX(calc((1 - var(--v))*30deg))}}

/* ---------- engagements ---------- */
.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.plan{padding:30px;border-radius:var(--r);border:1px solid var(--line);background:rgba(6,34,42,.5);display:flex;flex-direction:column;gap:14px}
.plan.hot{border-color:var(--cyan);background:linear-gradient(170deg,rgba(118,251,238,.12),rgba(6,34,42,.6));box-shadow:0 30px 70px -40px rgba(118,251,238,.6)}
.plan h4{font-size:24px}
.plan .for{color:var(--mint);font-size:13px}
.plan p{color:var(--mute);font-size:14.5px}
.plan ul{list-style:none;display:grid;gap:8px;font-size:14.5px}
.plan li::before{content:"✓  ";color:var(--cyan);font-weight:700}
.plan .btn{margin-top:auto;justify-content:center}
@media (max-width:900px){.plans{grid-template-columns:1fr}}

/* ---------- about ---------- */
.home-about{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(24px,5vw,70px);align-items:center}
.portrait{perspective:1200px}
.portrait .media{aspect-ratio:4/5;border-radius:28px;border:1px solid var(--line2);transform:rotateY(calc(var(--ry,0)*1deg)) rotateX(calc(var(--rx,0)*1deg));transition:transform .2s}
.home-about p{color:var(--mute);margin-bottom:16px;font-size:clamp(15px,1.2vw,17px)}
.home-about p b{color:var(--ink)}
.home-about.solo{grid-template-columns:1fr;max-width:820px}
@media (max-width:860px){.home-about{grid-template-columns:1fr}.portrait{max-width:380px}}


/* ---------- contact ---------- */
.contact-box{border-radius:32px;border:1px solid var(--line2);padding:clamp(28px,5vw,64px);
  background:radial-gradient(600px 300px at 90% 0%,rgba(118,251,238,.22),transparent 70%),linear-gradient(160deg,#0a3540,#051c22);
  display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,4vw,56px)}
.contact-box h2{font-size:clamp(30px,4.4vw,56px);margin:14px 0}
.contact-box > div > p{color:var(--mute)}
.links{display:grid;gap:10px;margin-top:26px}
.links a{display:flex;justify-content:space-between;align-items:center;padding:16px 20px;border-radius:16px;border:1px solid var(--line);background:rgba(255,255,255,.02);transition:border-color .25s,background .25s}
.links a:hover{border-color:var(--cyan);background:rgba(118,251,238,.06)}
.links a span{color:var(--mute);font-size:14px}
.links a.pending span::after{content:" · link coming soon"}
#calendlyBox{min-height:520px;border-radius:20px;border:1px dashed var(--line2);display:grid;place-items:center;text-align:center;color:var(--dim);padding:20px;overflow:hidden}
#calendlyBox iframe{width:100%;height:640px;border:0;border-radius:20px}
@media (max-width:900px){.contact-box{grid-template-columns:1fr}#calendlyBox{min-height:300px}}


/* reduced motion */
@media (prefers-reduced-motion:reduce){
  *{transition:none!important;scroll-behavior:auto!important}
  .funnel,.skills{height:auto}
  .funnel .stage,.skills .stage{position:relative;height:auto;padding:80px 0}
  .card-in,.step,.node{transform:none!important;opacity:1!important}
}

/* ---------- hero word flip ---------- */
.hero h1{perspective:900px}
.hero h1 .grad-text{background:none}
.hero h1 .w{display:inline-block;transform-origin:50% 90%;animation:wflip .9s cubic-bezier(.2,.75,.2,1) both;animation-delay:calc(var(--i)*55ms + .15s)}
.hero h1 .grad-text .w{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
@keyframes wflip{from{opacity:0;transform:rotateX(-95deg) translateY(.35em)}}
.panel .who{margin:0 0 10px}

/* ---------- 3D tools ribbon ---------- */
.ribbon{position:relative;height:clamp(160px,20vw,240px);overflow:hidden;perspective:900px}
.rb{position:absolute;left:-15%;right:-15%;padding:clamp(12px,1.4vw,18px) 0;box-shadow:0 30px 60px -30px rgba(0,0,0,.8)}
.rb1{top:16%;transform:rotateZ(-4deg) rotateX(16deg);background:var(--grad);color:#052a2c;z-index:2}
.rb2{top:52%;transform:rotateZ(3deg) rotateX(-12deg);background:rgba(8,32,37,.95);border-block:1px solid var(--line2);color:var(--cyan)}
.rb-track{display:flex;gap:30px;white-space:nowrap;font-family:var(--disp);font-weight:700;font-size:clamp(17px,2.2vw,28px);letter-spacing:-.01em;transform:translateX(calc(var(--x,0)*1px))}
.rb-track span{display:inline-flex;align-items:center;gap:30px}
.rb-track span::after{content:"";width:9px;height:9px;border-radius:2px;rotate:45deg;background:currentColor;opacity:.55}

/* ---------- Funnel X-ray (interactive) ---------- */
.xray-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:clamp(20px,4vw,60px);align-items:center}
.xr-scene{perspective:1400px;height:clamp(320px,38vw,460px);display:grid;place-items:center}
.xr-stack{position:relative;width:min(80%,330px);aspect-ratio:1.25;transform-style:preserve-3d;transform:rotateX(60deg) rotateZ(-38deg)}
.xr-plate{position:absolute;inset:0;border-radius:20px;border:1px solid var(--line2);
  background:linear-gradient(135deg,rgba(20,184,166,.22),rgba(118,251,238,.06));transform:translateZ(calc(var(--i)*74px));
  display:grid;place-items:center;font-family:var(--disp);font-weight:600;font-size:clamp(13px,1.3vw,16px);color:var(--ink);
  transition:transform .7s cubic-bezier(.2,.8,.2,1),background .4s,border-color .4s,box-shadow .4s,opacity .4s}
.xr-plate.ok{background:linear-gradient(135deg,rgba(20,184,166,.6),rgba(118,251,238,.35));border-color:var(--cyan)}
.xr-plate.leak{background:linear-gradient(135deg,rgba(255,118,84,.7),rgba(255,184,104,.4));border-color:#ffb27a;color:#fff;
  box-shadow:0 0 80px rgba(255,140,90,.5);transform:translateZ(calc(var(--i)*74px + 46px)) translate(34px,-34px);animation:leak 1.6s ease-in-out infinite}
@keyframes leak{50%{box-shadow:0 0 30px rgba(255,140,90,.25)}}
.xr-plate.dim{opacity:.28}
.xr-q{display:flex;justify-content:space-between;align-items:center;gap:14px;padding:14px 16px 14px 18px;border-radius:16px;border:1px solid var(--line);background:rgba(10,34,40,.5);margin-bottom:10px;transition:border-color .3s}
.xr-q p{color:var(--ink);font-weight:500}
.xr-q small{display:block;color:var(--dim);font-size:12px;letter-spacing:.08em;text-transform:uppercase}
.xr-q.no{border-color:rgba(255,160,110,.6)}
.xr-q.yes{border-color:var(--line2)}
.yn{display:flex;gap:6px;flex:none}
.yn button{padding:8px 16px;border-radius:999px;border:1px solid var(--line2);background:transparent;color:var(--ink);cursor:pointer;font-weight:600;font-size:14px;transition:background .2s,color .2s}
.yn button.sel[data-a=yes]{background:var(--grad);color:#052a2c;border-color:transparent}
.yn button.sel[data-a=no]{background:#ff9a6b;color:#2a0d00;border-color:transparent}
.xr-result{padding:24px;margin-top:16px}
.xr-result h3{font-size:clamp(22px,2.4vw,30px);margin:6px 0 8px}
.xr-result p{margin-bottom:18px}
.xr-result.hot{border-color:rgba(255,160,110,.6)}
@media (max-width:900px){.xray-grid{grid-template-columns:1fr}.xr-scene{height:300px}}
@media (max-width:420px){.xr-q{flex-direction:column;align-items:flex-start}}

</style>
