---
import { site } from '../config/site';
const links = [
  { href: '/work', label: 'Work' },
  { href: '/services', label: 'Services' },
  { href: '/notes', label: 'Notes' },
  { href: '/tools', label: 'Free tools' },
  { href: '/contact', label: 'Contact' },
  ...(site.socials.linkedin ? [{ href: site.socials.linkedin, label: 'LinkedIn' }] : []),
  ...(site.socials.instagram ? [{ href: site.socials.instagram, label: 'Instagram' }] : []),
  ...(site.socials.youtube ? [{ href: site.socials.youtube, label: 'YouTube' }] : []),
];
---
<footer class="footer">
  <span>© {new Date().getFullYear()} {site.name} · {site.city}, {site.country} · <a href={site.company.url}>{site.company.name}</a></span>
  <nav class="footerlinks" aria-label="Footer">
    {links.map((l) => <a href={l.href} {...(l.href.startsWith('http') ? { rel: 'me noopener', target: '_blank' } : {})}>{l.label}</a>)}
  </nav>
</footer>
