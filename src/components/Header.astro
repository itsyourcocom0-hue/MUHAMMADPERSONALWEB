---
import { nav } from '../config/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="top">
  <a class="brand" href="/" aria-label="Muhammad Farooqui — home">
    <span class="mark" aria-hidden="true">MF</span>
    <span class="name">Muhammad Farooqui</span>
  </a>
  <button class="menu" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
  <nav class="nav" id="site-nav" aria-label="Main">
    {nav.map((item) => (
      <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
    <a class="contact" href="/contact" aria-current={isCurrent('/contact') ? 'page' : undefined}>Get in touch</a>
  </nav>
</header>
<script>
  const menu = document.querySelector<HTMLButtonElement>('.menu');
  const navEl = document.querySelector<HTMLElement>('.nav');
  const set = (open: boolean) => {
    menu?.setAttribute('aria-expanded', String(open));
    navEl?.classList.toggle('open', open);
    if (menu) menu.textContent = open ? 'Close' : 'Menu';
  };
  menu?.addEventListener('click', () => set(menu.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
  navEl?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
</script>
